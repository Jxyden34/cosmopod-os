[Unit]
Description=Cosmopod seat and device broker
Documentation=man:seatd(1)
Before=weston.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
Environment=SEATD_VTBOUND=0
ExecStart=/usr/bin/seatd -g seat -l error
ExecStartPost=/bin/sh -c 'while [ ! -S /run/seatd.sock ]; do sleep 0.05; done'
# ISO cold boots under software emulation can exceed ten seconds before the
# socket is ready. Keep readiness mandatory, with a bounded startup budget.
TimeoutStartSec=90
Restart=on-failure
RestartSec=1
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=graphical.target
